# Notificator environment configuration (copy to .env and adjust)
#
# The dev/start scripts load this file automatically via Node's native
# --env-file-if-exists=.env flag (no dotenv dependency required). The flag is a
# no-op when .env is absent, so nothing breaks if you skip this step.

# Discord webhook used to deliver alerts. Optional at M0; required from M5
# onward. Leave blank to boot without notifications (blank is treated as
# "unset" by the config loader).
DISCORD_WEBHOOK_URL=

# Binance public market-data WebSocket base URL.
BINANCE_WS_URL=wss://stream.binance.com:9443

# Comma-separated Binance stream symbols (lowercase).
SYMBOLS=btcusdt,ethusdt

# HTTP port for the REST API (added in a later milestone).
PORT=3000

# Discord send rate limit (messages per second).
SEND_RATE_PER_SEC=1

# Maximum number of queued outbound notifications.
QUEUE_MAX=1000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
